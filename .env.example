# Copy to .env to override defaults. `docker compose up --build` also works without a .env file.

# Database
POSTGRES_DB=ailibrary
POSTGRES_USER=ailibrary
POSTGRES_PASSWORD=change-me

# Backend auth (replace in production: openssl rand -base64 48). The prod profile refuses the default.
JWT_SECRET=change-me-with-at-least-32-characters-long-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
APP_CORS_ORIGINS=http://localhost:3000
# Comma-separated emails that get the ADMIN role (on registration and at startup)
APP_ADMIN_EMAILS=

# AI chat - Groq (OpenAI-compatible). Key: https://console.groq.com/keys
AI_ENABLED=false
GROQ_API_KEY=
# The OpenAI SDK used by Spring AI 2.0 expects the versioned path (/v1).
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL_FAST=openai/gpt-oss-20b
AI_MODEL_SMART=openai/gpt-oss-120b
AI_RATE_LIMIT_PER_MINUTE=20
AI_GLOBAL_RATE_PER_MINUTE=25

# AI embeddings - local ONNX all-MiniLM-L6-v2 (no key). Must match the vector column size.
VECTOR_ENABLED=true
AI_EMBEDDING_DIMENSIONS=384
AI_EMBEDDING_CACHE_DIR=/data/onnx-cache

# External catalogs
OPEN_LIBRARY_USER_AGENT="AILibraryPortfolio/0.1 (contact: you@example.com)"
GOOGLE_BOOKS_API_KEY=

# Frontend: the browser calls /api on the frontend origin; the Next proxy forwards to this URL at runtime.
API_INTERNAL_URL=http://localhost:8080
