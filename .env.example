# Database
POSTGRES_DB=ailibrary
POSTGRES_USER=ailibrary
POSTGRES_PASSWORD=ailibrary

# Backend auth (replace in production)
JWT_SECRET=change-me-with-at-least-32-characters-long-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Comma-separated emails that get the ADMIN role (on registration and at startup)
APP_ADMIN_EMAILS=

# AI chat - Groq (OpenAI-compatible). Key: https://console.groq.com/keys
AI_ENABLED=false
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL_FAST=llama-3.1-8b-instant
AI_MODEL_SMART=llama-3.3-70b-versatile
AI_RATE_LIMIT_PER_MINUTE=20
AI_GLOBAL_RATE_PER_MINUTE=25

# AI embeddings - local ONNX all-MiniLM-L6-v2 (no key). Must match the vector column size.
VECTOR_ENABLED=true
AI_EMBEDDING_DIMENSIONS=384
AI_EMBEDDING_CACHE_DIR=/data/onnx-cache

# External catalogs
OPEN_LIBRARY_USER_AGENT=AILibraryPortfolio/0.1 (contact: replace@example.com)
GOOGLE_BOOKS_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
