# Database
POSTGRES_DB=ailibrary
POSTGRES_USER=ailibrary
POSTGRES_PASSWORD=ailibrary

# Backend auth (replace in production)
JWT_SECRET=change-me-with-at-least-32-characters-long-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Comma-separated emails that get the ADMIN role (on registration and at startup)
APP_ADMIN_EMAILS=

# AI - OpenAI or OpenAI-compatible endpoint (OpenRouter can be configured by base URL/model)
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_MAX_REQUESTS_PER_MINUTE=30

# External catalogs
OPEN_LIBRARY_USER_AGENT=AILibraryPortfolio/0.1 (contact: replace@example.com)
GOOGLE_BOOKS_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
